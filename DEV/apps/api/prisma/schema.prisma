  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  department  Department   @relation(fields: [departmentId], references: [id])
  expenseLines  ExpenseLine[]
  approvalRules CostCodeApprovalRule[]
  submissions   Submission[]

  @@index([departmentId, isDeleted])
  @@map("CostCode")
}

// ─── ApprovalConfig ───────────────────────────────────────────────────────────
model ApprovalConfig {
  id           String @id
  departmentId String @unique @map("DepartmentId")
