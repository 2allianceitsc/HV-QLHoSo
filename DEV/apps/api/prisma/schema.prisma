// This is your Prisma schema file
// https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── UserLogin ───────────────────────────────────────────────────────────────
model UserLogin {
  id           String    @id
  username     String    @map("Username")
  email        String    @map("Email")
  passwordHash String    @map("PasswordHash")
  isFirstLogin Boolean   @default(true) @map("IsFirstLogin")
  isActive       Boolean   @default(true) @map("IsActive")
  lastLogin            DateTime? @map("LastLogin") @db.Timestamptz
  allSessionsRevokedAt DateTime? @map("AllSessionsRevokedAt") @db.Timestamptz
  auth2FAEnabled  Boolean   @default(false) @map("Auth2FAEnabled")
  auth2FAMethod   String?   @map("Auth2FAMethod")   // 'TOTP' | 'EMAIL_OTP'
  auth2FARequired Boolean   @default(false) @map("Auth2FARequired")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  staff         Staff?
  auth2FASecret Auth2FASecret?
  loginOtps     LoginOtp[]

  @@index([username, isDeleted])   // login lookup by username
  @@index([email, isDeleted])      // login lookup by email
  @@map("UserLogin")
}

// ─── Company ─────────────────────────────────────────────────────────────────
model Company {
  id          String  @id
  name        String  @map("Name")
  code        String? @unique @map("Code")
  address     String? @map("Address")
  phone       String? @map("Phone")
  logoUrl     String? @map("LogoUrl")
  taxCode     String? @map("TaxCode")
  website     String? @map("Website")
  colorHex         String? @map("ColorHex")
  iconId           String? @map("IconId")
  defaultTimezone  String? @map("DefaultTimezone") // IANA e.g. "Asia/Ho_Chi_Minh"

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  contacts          CompanyContacts[]
  departments       Department[]
  offices           Office[]
  positions         Position[]
  teams             Team[]
  staff             Staff[]
  dropdownDisplayConfigs DropdownDisplayConfig[]
  managers          CompanyManager[]

  @@map("Company")
}

// ─── DropdownDisplayConfig ───────────────────────────────────────────────────
// Company-wide config for dropdown display format across the app.
// See: docs/screens/settings/S09-dropdown-display-settings.md
model DropdownDisplayConfig {
  id              String   @id
  companyId       String   @map("CompanyId")
  entityType      String   @map("EntityType") // STAFF | CLIENT | DEPARTMENT | OFFICE | TEAM | STATUS
  primaryField    String   @map("PrimaryField")
  secondaryFields String[] @default([]) @map("SecondaryFields") // empty = hide secondary line

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entityType])
  @@index([companyId])
  @@map("DropdownDisplayConfig")
}

// ─── CompanyContacts ──────────────────────────────────────────────────────────
model CompanyContacts {
  id                  String  @id
  companyId           String  @map("CompanyId")
  firstName           String  @map("FirstName")
  surname             String  @map("Surname")
  emailAddress        String? @map("EmailAddress")
  mobileCountryCode   String? @map("MobileCountryCode")
  mobileNumber        String? @map("MobileNumber")
  landlineCountryCode String? @map("LandlineCountryCode")
  landlineAreaCode    String? @map("LandlineAreaCode")
  landlineNumber      String? @map("LandlineNumber")
  streetAddress       String? @map("StreetAddress")
  suburb              String? @map("Suburb")
  city                String? @map("City")
  state               String? @map("State")
  country             String? @map("Country")
  postcode            String? @map("Postcode")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company Company @relation(fields: [companyId], references: [id])

  @@map("CompanyContacts")
}

// ─── Department ──────────────────────────────────────────────────────────────
model Department {
  id        String  @id
  companyId String  @map("CompanyId")
  name      String  @map("Name")
  code      String? @map("Code")
  colorHex  String? @map("ColorHex")
  iconId    String? @map("IconId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company  Company @relation(fields: [companyId], references: [id])
  staff    Staff[]
  managers DepartmentManager[]

  // HV relations
  costCodes              CostCode[]
  approvalConfig         ApprovalConfig?
  submissions            Submission[]
  approvalRuleDetails    CostCodeApprovalRuleDetail[]

  @@map("Department")
}

// ─── Office ──────────────────────────────────────────────────────────────────
model Office {
  id        String  @id
  companyId String  @map("CompanyId")
  name      String  @map("Name")
  code      String? @map("Code")
  address   String? @map("Address")
  timezone  String? @map("Timezone")
  country   String? @map("Country")
  city      String? @map("City")
  colorHex  String? @map("ColorHex")
  iconId    String? @map("IconId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company           Company            @relation(fields: [companyId], references: [id])
  staff             Staff[]
  managers          OfficeManager[]

  @@map("Office")
}

// ─── Position ─────────────────────────────────────────────────────────────────
model Position {
  id        String  @id
  companyId String  @map("CompanyId")
  name      String  @map("Name")
  code      String? @map("Code")
  level     Int?    @map("Level")
  colorHex  String? @map("ColorHex")
  iconId    String? @map("IconId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company Company @relation(fields: [companyId], references: [id])
  staff   Staff[]

  @@map("Position")
}

// ─── Team ─────────────────────────────────────────────────────────────────────
model Team {
  id        String  @id
  companyId String  @map("CompanyId")
  name      String  @map("Name")
  code      String? @map("Code")
  colorHex  String? @map("ColorHex")
  iconId    String? @map("IconId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  company           Company             @relation(fields: [companyId], references: [id])
  staff             Staff[]
  managers          TeamManager[]       @relation("TeamManagers")

  @@map("Team")
}

// ─── CompanyManager ───────────────────────────────────────────────────────────
model CompanyManager {
  id        String @id
  companyId String @map("CompanyId")
  staffId   String @map("StaffId")

  // Standard columns
  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  company Company @relation(fields: [companyId], references: [id])
  staff   Staff   @relation("CompanyManagers", fields: [staffId], references: [id])

  @@unique([companyId, staffId])
  @@index([companyId, isDeleted])
  @@index([staffId, isDeleted])
  @@map("CompanyManager")
}

// ─── DepartmentManager ────────────────────────────────────────────────────────
model DepartmentManager {
  id           String @id
  departmentId String @map("DepartmentId")
  staffId      String @map("StaffId")

  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  department Department @relation(fields: [departmentId], references: [id])
  staff      Staff      @relation("DepartmentManagers", fields: [staffId], references: [id])

  @@unique([departmentId, staffId])
  @@index([departmentId, isDeleted])
  @@index([staffId, isDeleted])
  @@map("DepartmentManager")
}

// ─── OfficeManager ────────────────────────────────────────────────────────────
model OfficeManager {
  id       String @id
  officeId String @map("OfficeId")
  staffId  String @map("StaffId")

  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  office Office @relation(fields: [officeId], references: [id])
  staff  Staff  @relation("OfficeManagers", fields: [staffId], references: [id])

  @@unique([officeId, staffId])
  @@index([officeId, isDeleted])
  @@index([staffId, isDeleted])
  @@map("OfficeManager")
}

// ─── TeamManager ──────────────────────────────────────────────────────────────
model TeamManager {
  id      String @id
  teamId  String @map("TeamId")
  staffId String @map("StaffId")

  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  team  Team  @relation("TeamManagers", fields: [teamId], references: [id])
  staff Staff @relation("TeamManagers", fields: [staffId], references: [id])

  @@unique([teamId, staffId])
  @@index([teamId, isDeleted])
  @@index([staffId, isDeleted])
  @@map("TeamManager")
}

// ─── Staff ────────────────────────────────────────────────────────────────────
model Staff {
  id                   String    @id
  userLoginId          String?   @unique @map("UserLoginId")
  employeeId           String    @unique @map("EmployeeId")
  companyId            String    @map("CompanyId")
  companyIdForReporting String?  @map("CompanyIdForReporting")
  departmentId         String?   @map("DepartmentId")
  officeId             String?   @map("OfficeId")
  positionId           String?   @map("PositionId")
  teamId               String?   @map("TeamId")

  firstName            String    @map("FirstName")
  middleName           String?   @map("MiddleName")
  surname              String    @map("Surname")
  companyEmailAddress  String?   @unique @map("CompanyEmailAddress")
  mobileNumber         String?   @map("MobileNumber")
  dateOfBirth          DateTime? @map("DateOfBirth") @db.Date
  gender               Int?      @map("Gender")
  taxIdNumber          String?   @map("TaxIdNumber")
  // Extended personal fields
  englishSurname       String?   @map("EnglishSurname")
  homePhoneAreaCode    String?   @map("HomePhoneAreaCode")
  homePhoneNumber      String?   @map("HomePhoneNumber")
  favoriteCake         String?   @map("FavoriteCake")
  // Government IDs (Philippines)
  sssNumber            String?   @map("SSSNumber")
  philHealthIdNumber   String?   @map("PhilHealthIdNumber")
  hdmfNumber           String?   @map("HDMFNumber")
  // Banking (HR only)
  nominatedBankName           String?   @map("NominatedBankName")
  nominatedBankAccountName    String?   @map("NominatedBankAccountName")
  nominatedBankAccountNumber  String?   @map("NominatedBankAccountNumber")
  photoBusiness        String?   @map("PhotoBusiness")
  photoBirthday        String?   @map("PhotoBirthday")
  avatarKey            String?   @map("AvatarKey")      // R2 object key; null = use avatarColor fallback
  presentAddress       String?   @map("PresentAddress")
  permanentAddress     String?   @map("PermanentAddress")
  personalEmailAddress String?   @map("PersonalEmailAddress")
  cityOfBirth          String?   @map("CityOfBirth")
  countryOfBirth       String?   @map("CountryOfBirth")
  maritalStatus        Int?      @map("MaritalStatus")
  firstNameOfSpouse    String?   @map("FirstNameOfSpouse")
  middleNameOfSpouse   String?   @map("MiddleNameOfSpouse")
  surnameOfSpouse      String?   @map("SurnameOfSpouse")
  numberOfChildren     Int?      @map("NumberOfChildren")
  emergencyContactFullName String? @map("EmergencyContactFullName")
  relationshipToYou    String?   @map("RelationshipToYou")
  emergencyContactAreaCode String? @map("EmergencyContactAreaCode")
  emergencyContactNumber   String? @map("EmergencyContactNumber")
  isPm                 Boolean   @default(false) @map("IsPm")
  is2FANeedEnable      Boolean   @default(false) @map("Is2FANeedEnable")  // Admin-set: force this user to do 2FA
  is2FAEnabled         Boolean   @default(false) @map("Is2FAEnabled")     // Set true after completing S43 setup
  showFloatingWidget      Boolean   @default(true)  @map("ShowFloatingWidget")
  floatingWidgetPosition  Json?     @default("{\"side\":\"right\",\"yOffset\":120}") @map("FloatingWidgetPosition")

  shiftStartTime       String?   @map("ShiftStartTime")
  shiftEndTime         String?   @map("ShiftEndTime")
  latestStartTime      String?   @map("LatestStartTime")
  latestEndShiftTime   String?   @map("LatestEndShiftTime")
  shiftEndDayOffset    Int       @default(0) @map("ShiftEndDayOffset")
  timezone             String?   @map("Timezone")  // IANA e.g. "Asia/Manila"

  // HV: Document approval roles — array, at least 1 element from {"staff","reviewer","approver","admin"}
  hvRoles              String[]  @default(["staff"]) @map("HvRoles")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  userLogin    UserLogin?    @relation(fields: [userLoginId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  office       Office?       @relation(fields: [officeId], references: [id])
  position     Position?     @relation(fields: [positionId], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id])

  staffRoles    StaffRole[]
  timeTrackings TimeTracking[]
  moodLogs      MoodLog[]
  notifications Notification[]
  staffAuthenticators StaffAuthenticator[]
  companyManagerRoles    CompanyManager[]    @relation("CompanyManagers")
  departmentManagerRoles DepartmentManager[] @relation("DepartmentManagers")
  officeManagerRoles     OfficeManager[]     @relation("OfficeManagers")
  teamManagerRoles       TeamManager[]       @relation("TeamManagers")

  // HV: Document approval relations
  submissionsCreated   Submission[] @relation("SubmissionSubmitter")
  submissionsToReview  Submission[] @relation("SubmissionReviewer")
  submissionsToApprove Submission[] @relation("SubmissionApprover")
  approvalConfigsAsReviewer ApprovalConfig[] @relation("ApprovalConfigReviewer")
  approvalConfigsAsApprover ApprovalConfig[] @relation("ApprovalConfigApprover")
  approvalRuleDetails  CostCodeApprovalRuleDetail[]
  stepAsApprover         SubmissionApprovalStep[] @relation("StepApprover")
  stepAsOriginalApprover SubmissionApprovalStep[] @relation("StepOriginalApprover")
  submissionLogs       SubmissionLog[]
  attachmentsUploaded  Attachment[]

  @@index([companyId, isDeleted])  // employee list filtered by company
  @@index([isDeleted, isDisabled]) // general list with active filter
  @@map("Staff")
}

// ─── Notification ─────────────────────────────────────────────────────────────
model Notification {
  id      String  @id
  staffId String  @map("StaffId")
  title   String  @map("Title")
  body    String  @map("Body")
  type    String  @map("Type")
  isRead  Boolean @default(false) @map("IsRead")
  readAt  DateTime? @map("ReadAt") @db.Timestamptz
  link    String?   @map("Link")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId, isDeleted, isRead]) // notification list + unread count
  @@map("Notification")
}

// ─── Role ─────────────────────────────────────────────────────────────────────
model Role {
  id          String  @id
  name        String  @unique @map("Name")
  displayName String? @map("DisplayName")
  description String? @map("Description")
  colorHex    String? @map("ColorHex")
  iconId      String? @map("IconId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  staffRoles      StaffRole[]
  rolePermissions RolePermission[]

  @@map("Role")
}

// ─── StaffRole ────────────────────────────────────────────────────────────────
model StaffRole {
  id      String @id
  staffId String @map("StaffId")
  roleId  String @map("RoleId")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  staff Staff @relation(fields: [staffId], references: [id])
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([staffId, roleId])
  @@index([staffId, isDeleted])    // role lookups per staff on login + employee view
  @@map("StaffRole")
}

// ─── Screen ───────────────────────────────────────────────────────────────────
// Catalog of UI screens. Stable `code` (e.g. "E04", "SY18") is the external
// identifier referenced by @RequiresScreen decorators and the FE manifest.
// See: docs/architecture/permission-model.md
model Screen {
  id             String  @id
  code           String  @unique @map("Code")         // "S13", "E04", "SY01"
  name           String  @map("Name")
  route          String  @map("Route")                // "/employees/:id"
  area           String  @map("Area")                 // "employee" | "system" | ...
  parentScreenId String? @map("ParentScreenId")
  description    String? @map("Description")

  // Standard columns
  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  parent      Screen?          @relation("ScreenHierarchy", fields: [parentScreenId], references: [id])
  children    Screen[]         @relation("ScreenHierarchy")
  tabs        ScreenTab[]
  permissions RolePermission[]

  @@index([area, orderNo])
  @@index([parentScreenId])
  @@index([isDeleted, isDisabled])
  @@map("Screen")
}

// ─── ScreenTab ────────────────────────────────────────────────────────────────
// Sub-region within a Screen that can be independently gated.
// A screen without rows here is "whole-screen only".
model ScreenTab {
  id          String  @id
  screenId    String  @map("ScreenId")
  code        String  @map("Code")                    // "personal", "roles", "hr-only"
  name        String  @map("Name")
  description String? @map("Description")

  // Standard columns
  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  screen      Screen           @relation(fields: [screenId], references: [id])
  permissions RolePermission[]

  @@unique([screenId, code])
  @@index([screenId, orderNo])
  @@index([isDeleted, isDisabled])
  @@map("ScreenTab")
}

// ─── Permission ───────────────────────────────────────────────────────────────
// Action catalog. Seeded and rarely mutated. Phase 1 enforces only VIEW;
// other codes are stored but not evaluated by the guard until Phase 4.
model Permission {
  code        String  @id @map("Code")                // "VIEW", "UPDATE", ...
  name        String  @map("Name")
  description String? @map("Description")

  orderNo      Int      @default(0) @map("OrderNo")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("Permission")
}

// ─── RolePermission ───────────────────────────────────────────────────────────
// The permission matrix. Each row says: role R is {allow|deny} for
// permission P on screen S, optionally scoped to tab T.
// tabId = NULL → whole-screen rule. tab-level rule overrides screen-level rule.
// Deny-override: any applicable isAllowed=false yields DENY.
// See: docs/architecture/permission-model.md § Resolution Rules
model RolePermission {
  id             String  @id
  roleId         String  @map("RoleId")
  screenId       String  @map("ScreenId")
  tabId          String? @map("TabId")                // NULL = whole screen
  permissionCode String  @map("PermissionCode")
  isAllowed      Boolean @map("IsAllowed")            // true = ALLOW, false = explicit DENY

  // Standard columns
  note         String?  @map("Note")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  isDisabled   Boolean  @default(false) @map("IsDisabled")
  orderNo      Int      @default(0) @map("OrderNo")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  role       Role       @relation(fields: [roleId], references: [id])
  screen     Screen     @relation(fields: [screenId], references: [id])
  tab        ScreenTab? @relation(fields: [tabId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  // Prisma-level compound unique. Does NOT handle NULL tabId duplicates —
  // a partial unique index (COALESCE(tabId, zero-uuid)) is created in
  // migration SQL to fully enforce uniqueness. See migration file.
  @@unique([roleId, screenId, tabId, permissionCode])
  @@index([roleId, isDeleted])
  @@index([screenId, tabId])
  @@index([permissionCode])
  @@map("RolePermission")
}

// ─── TimeTracking ─────────────────────────────────────────────────────────────
model TimeTracking {
  id               String    @id
  staffId          String    @map("StaffId")
  statusId         String    @map("StatusId")
  startTime        DateTime  @map("StartTime") @db.Timestamptz
  endTime          DateTime? @map("EndTime") @db.Timestamptz
  durationSeconds  Int?      @map("DurationSeconds")
  shiftStartTime   String?   @map("ShiftStartTime")
  shiftEndTime     String?   @map("ShiftEndTime")
  maxBreakSeconds  Int?      @map("MaxBreakSeconds")
  timezone         String?   @map("Timezone")
  ipAddress        String?   @map("IpAddress")
  userAgent        String?   @map("UserAgent")
  notes            String?   @map("Notes")
  debugInfo        String?   @map("DebugInfo")
  isLoginStatus    Boolean   @default(false) @map("IsLoginStatus")
  isSuperseded     Boolean   @default(false) @map("IsSuperseded")

  // Standard columns
  note         String?   @map("Note")
  isDeleted    Boolean   @default(false) @map("IsDeleted")
  isDisabled   Boolean   @default(false) @map("IsDisabled")
  orderNo      Int       @default(0) @map("OrderNo")
  logCreatedAt DateTime  @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?   @map("Log_CreatedBy")
  logUpdatedAt DateTime  @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?   @map("Log_UpdatedBy")

  staff  Staff            @relation(fields: [staffId], references: [id])

  // Performance indexes
  @@index([staffId, endTime, isDeleted])              // closeOpenRecord / changeStatus / createLoginTimeTracking: find open row per staff
  @@index([staffId, startTime])                       // getTodayAttendance + getHistory ordering
  @@index([endTime, isDeleted])                       // autoLogout cron: find all open records
  @@index([staffId, isLoginStatus, endTime, isDeleted]) // hasLogin check (late-arrival cron): did staff log in today?
  @@map("TimeTracking")
}

