# Environment Variables Example — HV QuyTrinhDuyetHoSo
# Copy to .env and fill in values

# Database (PostgreSQL — Railway or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/HV_QuyTrinhDuyetHoSo_Dev"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="30d"

# App — ports hardcoded (Vibe365 + 28 offset to avoid conflicts)
PORT=3028
NODE_ENV=development
CORS_ORIGIN="http://localhost:5418"

# Frontend feature flags (Vite build-time vars — must be set before pnpm build)
# Set to "true" in dev/staging to show test account shortcuts on login page.
# Leave unset (or omit) in production to hide them.
VITE_SHOW_TEST_ACCOUNTS=true

# Google Login (Firebase)
# Firebase project ID — used by firebase-admin on the backend to verify Google ID Tokens.
# Get from Firebase Console → Project settings → General → Project ID.
FIREBASE_PROJECT_ID=""

# Frontend Firebase config (Vite build-time vars — prefix VITE_ required)
# Get from Firebase Console → Project settings → Your apps → Web app → SDK setup.
# IMPORTANT: Do NOT commit real values — these are public-safe but belong in .env.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# Google Chat
# Incoming webhook URL for system alerts (error logs, notifications).
# Get from Google Chat space → Manage webhooks.
GOOGLE_CHAT_WEBHOOK_URL=""
