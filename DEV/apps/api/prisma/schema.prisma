  approver   Staff      @relation("ApprovalConfigApprover", fields: [approverId], references: [id])

  @@map("ApprovalConfig")
}

// ─── Submission ───────────────────────────────────────────────────────────────
// status values: draft | pending_review | in_review | approved | rejected
// type values:   MS (Mua sắm) | NT (Nguyên tắc)
model Submission {
  id                String    @id
  type              String    @map("Type")             // "MS" | "NT"
  code              String    @unique @map("Code")     // e.g. MS0001
  submitterId       String    @map("SubmitterId")
  departmentId      String    @map("DepartmentId")
  submittedDate     DateTime  @map("SubmittedDate") @db.Date
  title             String    @map("Title")
  content           String    @map("Content") @db.Text
  status            String    @default("draft") @map("Status")
  costCodeId        String?   @map("CostCodeId")        // HV approval-rules: 1 submission = 1 cost code (NT may be null)
  reviewerId        String?   @map("ReviewerId")        // legacy 1-1 model; replaced by approvalSteps
  approverId        String?   @map("ApproverId")        // legacy 1-1 model; replaced by approvalSteps
  reviewedAt        DateTime? @map("ReviewedAt") @db.Timestamptz
  approvedAt        DateTime? @map("ApprovedAt") @db.Timestamptz
  rejectionReason   String?   @map("RejectionReason") @db.Text

  // NT-specific fields
  contractStartDate DateTime? @map("ContractStartDate") @db.Date
  contractEndDate   DateTime? @map("ContractEndDate") @db.Date
  supplier          String?   @map("Supplier")           // NT: primary supplier

  // Standard columns
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  submitter         Staff      @relation("SubmissionSubmitter", fields: [submitterId], references: [id])
  department        Department @relation(fields: [departmentId], references: [id])
  costCode          CostCode?  @relation(fields: [costCodeId], references: [id])
  reviewer          Staff?     @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  approver          Staff?     @relation("SubmissionApprover", fields: [approverId], references: [id])
  expenseLines      ExpenseLine[]
  existingInventory ExistingInventory[]
  attachments       Attachment[]
  approvalSteps     SubmissionApprovalStep[]
  logs              SubmissionLog[]

  @@index([departmentId, status, isDeleted])
  @@index([submitterId, isDeleted])
  @@index([status, isDeleted])
  @@map("Submission")
}

// ─── ExpenseLine ──────────────────────────────────────────────────────────────
model ExpenseLine {
  id           String  @id
  submissionId String  @map("SubmissionId")
  costCodeId   String  @map("CostCodeId")
  costCodeName String  @map("CostCodeName")    // snapshot at creation time
  amountExVat  BigInt  @map("AmountExVat")     // VND, no decimal
  vatRate      Int     @default(10) @map("VatRate")    // 1–100
  amountIncVat BigInt  @map("AmountIncVat")    // = amountExVat × (1 + vatRate/100), calculated by backend
  supplier     String  @map("Supplier")
  purchasedFor String? @map("PurchasedFor")
  purpose      String? @map("Purpose")
  usedBy       String? @map("UsedBy")
  sortOrder    Int     @default(1) @map("SortOrder")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  costCode   CostCode   @relation(fields: [costCodeId], references: [id])

  @@index([submissionId])
  @@map("ExpenseLine")
}

// ─── ExistingInventory ────────────────────────────────────────────────────────
model ExistingInventory {
  id           String @id
  submissionId String @map("SubmissionId")
  itemName     String @map("ItemName")
  quantity     Int    @map("Quantity")
  unit         String @map("Unit")
  sortOrder    Int    @default(1) @map("SortOrder")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("ExistingInventory")
}

// ─── Attachment ───────────────────────────────────────────────────────────────
// fileType values: "attachment" | "signed_contract"
model Attachment {
  id           String   @id
  submissionId String   @map("SubmissionId")
  fileType     String   @map("FileType")      // "attachment" | "signed_contract"
  name         String   @map("Name")
  storageKey   String   @map("StorageKey")    // R2 object key; publicUrl = R2_PUBLIC_URL + "/" + storageKey
  mimeType     String   @map("MimeType")
  sizeBytes    BigInt   @map("SizeBytes")
  uploadedBy   String   @map("UploadedBy")
  uploadedAt   DateTime @default(now()) @map("UploadedAt") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploader   Staff      @relation(fields: [uploadedBy], references: [id])

  @@index([submissionId])
  @@map("Attachment")
}

// ─── SubmissionStatus ─────────────────────────────────────────────────────────
// Fixed catalog — 5 rows, code is PK and immutable. Only label + colorHex editable.
model SubmissionStatus {
  code         String   @id @map("Code")    // "draft" | "pending_review" | "in_review" | "approved" | "rejected"
  label        String   @map("Label")
  colorHex     String   @map("ColorHex")
  orderNo      Int      @default(0) @map("OrderNo")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  @@map("SubmissionStatus")
}

// ─── SubmissionLog ────────────────────────────────────────────────────────────
// action values: create | update | submit | resubmit | review | approve | reject | delete
model SubmissionLog {
  id           String   @id
  submissionId String   @map("SubmissionId")
  userId       String   @map("UserId")
  action       String   @map("Action")
  fromStatus   String?  @map("FromStatus")
  toStatus     String?  @map("ToStatus")
  note         String?  @map("Note") @db.Text
  createdAt    DateTime @default(now()) @map("CreatedAt") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       Staff      @relation(fields: [userId], references: [id])

  @@index([submissionId])
  @@map("SubmissionLog")
}

// ─── CostCodeApprovalRule (header) ───────────────────────────────────────────
// Per BA approval-rules-by-cost-code.md §5.1
// - submissionType="MS": costCodeId required — per-cost-code rule, may use min/max thresholds
// - submissionType="NT": costCodeId NULL — single global rule, no thresholds
model CostCodeApprovalRule {
  id             String  @id
  submissionType String  @map("SubmissionType")  // "MS" | "NT"
  costCodeId     String? @map("CostCodeId")
  name           String? @map("Name")
  isActive       Boolean @default(true) @map("IsActive")

  isDeleted    Boolean  @default(false) @map("IsDeleted")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  costCode CostCode? @relation(fields: [costCodeId], references: [id])
  details  CostCodeApprovalRuleDetail[]

  @@unique([submissionType, costCodeId])
  @@index([submissionType, isActive, isDeleted])
  @@map("CostCodeApprovalRule")
}

// ─── CostCodeApprovalRuleDetail ──────────────────────────────────────────────
// stepType: "REVIEW" | "APPROVE"
// mode:     "ANY" | "ALL"
// minAmount/maxAmount: half-open interval [min, max) — NULL = unbounded; both NULL when rule is NT.
model CostCodeApprovalRuleDetail {
  id          String  @id
  ruleId      String  @map("RuleId")
  stepOrder   Int     @map("StepOrder")
  stepType    String  @map("StepType")
  stepLabel   String? @map("StepLabel")
  minAmount   BigInt? @map("MinAmount")
  maxAmount   BigInt? @map("MaxAmount")
  approverId   String  @map("ApproverId")
  mode         String  @default("ANY") @map("Mode")
  // NT only: NULL = fallback (all depts); non-null = route for that specific dept. Always NULL for MS.
  departmentId String? @map("DepartmentId")

  isDeleted    Boolean  @default(false) @map("IsDeleted")
  logCreatedAt DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz
  logCreatedBy String?  @map("Log_CreatedBy")
  logUpdatedAt DateTime @updatedAt @map("Log_UpdatedAt") @db.Timestamptz
  logUpdatedBy String?  @map("Log_UpdatedBy")

  rule       CostCodeApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  approver   Staff                @relation(fields: [approverId], references: [id])
  department Department?          @relation(fields: [departmentId], references: [id])

  @@index([ruleId, stepOrder, isDeleted])
  @@map("CostCodeApprovalRuleDetail")
}

// ─── SubmissionApprovalStep ──────────────────────────────────────────────────
// Snapshot of resolved workflow at submit time (BA D10).
// status: "pending" | "in_progress" | "approved" | "rejected" | "skipped"
model SubmissionApprovalStep {
  id                 String   @id
  submissionId       String   @map("SubmissionId")
  stepOrder          Int      @map("StepOrder")
  stepType           String   @map("StepType")
  stepLabel          String?  @map("StepLabel")
  approverId         String   @map("ApproverId")
  originalApproverId String   @map("OriginalApproverId")
  mode               String   @map("Mode")
  status             String   @default("pending") @map("Status")
  decidedAt          DateTime? @map("DecidedAt") @db.Timestamptz
  decidedBy          String?   @map("DecidedBy")
  comment            String?   @map("Comment") @db.Text

  reassignedAt       DateTime? @map("ReassignedAt") @db.Timestamptz
  reassignedBy       String?   @map("ReassignedBy")
  reassignReason     String?   @map("ReassignReason") @db.Text

  logCreatedAt       DateTime @default(now()) @map("Log_CreatedAt") @db.Timestamptz

  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approver         Staff      @relation("StepApprover", fields: [approverId], references: [id])
  originalApprover Staff      @relation("StepOriginalApprover", fields: [originalApproverId], references: [id])

  @@index([submissionId, stepOrder])
  @@index([approverId, status])
  @@map("SubmissionApprovalStep")
}
